  "transitions": [
    {
      "from": "upgrade",
      "to": "authing",
      "variant": "security",
      "channelY": 1660
    },
    {
      "from": "authing",
      "to": "authed",
      "variant": "emphasis",
      "channelY": -1890,
      "channelX": -200,
      "toSide": "right"
    },
    {
      "from": "authed",
      "to": "subscribing",
      "variant": "default"
    },
    {
      "from": "subscribing",
      "to": "subscribed",
      "variant": "emphasis",
      "channelY": -1660,
      "channelX": -260,
      "fromSide": "right"
    },
    {
      "from": "subscribed",
      "to": "publishing",
      "variant": "dashed",
      "fromSide": "top",
      "toSide": "bottom",
      "channelX": 820
    },
    {
      "from": "publishing",
      "to": "closing",
      "variant": "security",
      "channelY": -2370,
      "channelX": -200,
      "toSide": "right"
    },
    {
      "from": "closing",
      "to": "ok-fin",
      "variant": "emphasis"
    },
    {
      "from": "authing",
      "to": "kick",
      "variant": "security",
      "channelY": -1660
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Session Gate",
      "items": [
        "Upgrade 完成 + Auth 通过才进入 Authed；否则直接 kick，不接受任何 subscribe/publish 帧"
      ]
    },
    {
      "dot": "emerald",
      "title": "Subscribed → Pushing",
      "items": [
        "Subscribed 状态持续可发 Pushing；StdCancel 只退单订阅，其他 subId 继续维持 Subscribed"
      ]
    },
    {
      "dot": "rose",
      "title": "Graceful Close",
      "items": [
        "Closing 必须发送 close 帧给所有订阅；session 释放所有 subId，避免泄漏"
      ]
    }
  ]
}
