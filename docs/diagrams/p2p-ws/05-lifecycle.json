      "step": "04",
      "yOffset": 0,
      "width": 140,
      "height": 86
    },
    {
      "id": "ok-fin",
      "type": "success",
      "label": "Graceful End",
      "sublabel": "all subs unsub",
      "lane": "terminal",
      "col": 0,
      "tag": "terminal",
      "yOffset": 0,
      "width": 140,
      "height": 86
    },
    {
      "id": "new",
      "type": "start",
      "label": "New Session",
      "sublabel": "pre connect",
      "lane": "main",
      "col": 1,
      "step": "01",
      "yOffset": 80,
      "width": 140,
      "height": 86
    },
    {
      "id": "subscribing",
      "type": "active",
