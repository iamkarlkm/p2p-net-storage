  "cards": [
    {
      "dot": "cyan",
      "title": "Monitor Trigger",
      "items": [
        "P2PSyncMonitor 捕获修改/rename/delete；然后走同一 Chunker→ Dedup → Transport 流水线，不用手工触发"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two p2p-db Roles",
      "items": [
        "Dedup Index=内容哈希全局唯一；Upload Index=ns/task 下完成列表；两个表共同提供 Dedup + Resume 两个核心能力"
      ]
    },
    {
      "dot": "rose",
      "title": "E2E Strong",
      "items": [
        "Strong Content Check 是最终一致性的唯一保证；只要 hash 不等就不 rename，任何 chunk 丢/错都会在 finalize 暴露"
      ]
    }
  ]
