  "cards": [
    {
      "dot": "cyan",
      "title": "Chunk Persist Progress",
      "items": [
        "每收到 per-chunk ack 就写 Up-Idx；这样崩溃/网络断开后恢复只需要读 done 列表即可跳过已发 chunk"
      ]
    },
    {
      "dot": "amber",
      "title": "Paused→Resume",
      "items": [
        "Paused 不撤销任何 progress；下次运行 Resume Skip 直接从 idx 读；不用重推已完成 chunk，是广域网 sync 体验的关键"
      ]
    },
    {
      "dot": "rose",
      "title": "Hash Gate",
      "items": [
        "Finalized 前必须哈希 gate；match → Finalized OK 原子 rename；否则 Hash Mismatch，可再尝试 resume 重推只错的 chunk"
      ]
    }
  ]
}
