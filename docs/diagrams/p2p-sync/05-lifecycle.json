    {
      "from": "paused",
      "to": "resume",
      "variant": "dashed",
      "channelY": -1660
    },
    {
      "from": "assembled",
      "to": "hash-check",
      "variant": "security",
      "channelY": 1260
    },
    {
      "from": "resume",
      "to": "pushing",
      "variant": "emphasis",
      "channelY": -1660
    },
    {
      "from": "hash-check",
      "to": "ok",
      "variant": "emphasis",
      "channelY": 1030
    },
    {
      "from": "hash-check",
