    { "id": "e-pull-merge", "from": "pullRemote", "to": "merge", "label": "远端 Manifest", "variant": "emphasis" },
    { "id": "e-merge-conflict", "from": "merge", "to": "conflict", "label": "检测冲突?", "variant": "security" },
    { "id": "e-merge-done", "from": "merge", "to": "done", "variant": "emphasis", "role": "main", "label": "无冲突" },
    { "id": "e-conflict-resolve", "from": "conflict", "to": "resolve", "variant": "security", "role": "main" },
    { "id": "e-resolve-retry", "from": "resolve", "to": "retryMerge", "variant": "dashed", "role": "branch", "label": "消解完成" },
    { "id": "e-retry-done", "from": "retryMerge", "to": "done", "variant": "emphasis", "role": "return", "route": "outside-right", "fromSide": "right", "toSide": "right" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Schema v2 布局合约", "items": ["lanes + columns 决定节点几何", "mainPath 贯穿检测到完成", "异常分支由 conflict 和 retry 组承担"] },
    { "dot": "emerald", "title": "同步循环步骤", "items": ["检测变更 → Chunking → Manifest Hash", "上传缺失 Chunks → 拉取远端 Manifest", "Merge → 冲突处理 → 写入 Timeline"] },
    { "dot": "rose", "title": "异常与重试", "items": ["网络层指数退避重试", "冲突策略支持 CRDT / LWW / 人工", "重试合并后统一流向完成"] }
  ]
}
