    "views": [
      { "id": "happy-sync", "label": "完整同步循环", "focus": ["detect", "chunking", "hash", "uploadMissing", "pullRemote", "merge", "conflict", "done"], "note": "从变更检测到完成的标准同步主路径。" },
      { "id": "conflict-handling", "label": "冲突处理分支", "focus": ["merge", "conflict", "resolve", "retryMerge", "done"], "note": "清单冲突检测、消解与重试合并的异常处理分支。" },
      { "id": "network-branch", "label": "网络重试分支", "focus": ["uploadMissing", "networkRetry", "pullRemote"], "note": "上传失败时的指数退避重试与跳过策略。" }
    ]
  },
  "lanes": [
    { "id": "local", "label": "本地变更" },
    { "id": "chunks", "label": "分块与哈希" },
    { "id": "network", "label": "网络传输" },
    { "id": "merge", "label": "合并与冲突", "variant": "exception" }
  ],
  "phases": [
    { "id": "local-phase", "label": "本地处理", "fromCol": 0, "toCol": 2 },
    { "id": "net-phase", "label": "网络同步", "fromCol": 3, "toCol": 3, "variant": "emphasis" },
    { "id": "merge-phase", "label": "合并落盘", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "local-loop", "label": "变更分块子流程", "lane": "chunks", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "conflict-group", "label": "冲突消解子流程", "lane": "merge", "fromCol": 4, "toCol": 5, "variant": "security" },
    { "id": "retry-group", "label": "网络重试", "lane": "network", "fromCol": 3, "toCol": 3, "variant": "dashed" }
  ],
  "mainPath": ["detect", "chunking", "hash", "uploadMissing", "pullRemote", "merge", "conflict", "done"],
  "nodes": [
    { "id": "detect", "lane": "local", "col": 0, "type": "external", "label": "检测变更", "sublabel": "Watcher + mtime", "width": 140 },
