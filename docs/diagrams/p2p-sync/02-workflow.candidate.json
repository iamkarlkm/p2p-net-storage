    { "id": "e-chunk-hash", "from": "chunking", "to": "hash", "label": "生成 Chunk 列表" },
    { "id": "e-hash-upload", "from": "hash", "to": "uploadMissing", "label": "缺失清单", "variant": "emphasis" },
