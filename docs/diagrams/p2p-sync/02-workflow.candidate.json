    { "id": "uploadMissing", "lane": "network", "col": 3, "type": "backend", "label": "上传缺失 Chunks", "sublabel": "逐块并发", "tag": "P2P 传输", "width": 140 },
    { "id": "pullRemote", "lane": "network", "col": 3, "type": "messagebus", "label": "拉取远端 Manifest", "sublabel": "差异对比", "width": 140, "yOffset": 120 },
    { "id": "networkRetry", "lane": "network", "col": 3, "type": "backend", "label": "网络重试", "sublabel": "指数退避", "width": 140, "yOffset": -120 },
