    { "id": "resolve", "lane": "merge", "col": 5, "type": "security", "label": "冲突消解", "sublabel": "人工或自动", "width": 140 },
    { "id": "retryMerge", "lane": "merge", "col": 5, "type": "messagebus", "label": "重试合并", "sublabel": "应用消解结果", "width": 140, "yOffset": -120 },
    { "id": "done", "lane": "local", "col": 5, "type": "backend", "label": "完成", "sublabel": "写入 Timeline", "tag": "ACK", "width": 140 }
