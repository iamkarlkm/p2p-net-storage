  "cards": [
    {
      "dot": "cyan",
      "title": "Content Deduplication",
      "items": [
        "内容哈希分块；去重索引存在则直接跳过该 chunk；跨文件跨任务全局共享唯一 chunk 字节"
      ]
    },
    {
      "dot": "emerald",
      "title": "Resume + Namespace",
      "items": [
        "Upload Index 以 namespace+task 分桶，避免跨任务 chunk id 冲突；断点续传根据已上传的 chunk list 跳过已完成部分"
      ]
    },
    {
      "dot": "rose",
      "title": "Atomic Finalize",
      "items": [
        "远端 chunk 合入临时文件 → finalize 原子 move → 强 E2E 内容哈希校验；不满足则回滚到临时文件"
      ]
    }
