  "cards": [
    {
      "dot": "emerald",
      "title": "Resume Hot Path",
      "items": [
        "打开 Upload Index 拿到 done chunk，chunker 直接跳过；不用重算已上传字节"
      ]
    },
    {
      "dot": "rose",
      "title": "Atomic Rename",
      "items": [
        "server 端所有 chunk 先写 tmp；finalize 请求触发 hash compare → 原子 rename 才对外部可见；失败保留 tmp 给下次 resume"
      ]
    },
    {
      "dot": "amber",
      "title": "Namespace + Task",
      "items": [
        "Up-Idx 必须 composite key: (namespace, task, chunkId)；避免不同同步任务的同名 chunk 串扰"
      ]
    }
  ]
