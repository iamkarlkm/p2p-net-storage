  "cards": [
    {
      "dot": "emerald",
      "title": "Handshake Order",
      "items": [
        "QUIC → Hello nonce 交换 → AUTH_SIG verify signature → register session → 业务 frame 才放行；会话未注册前的业务帧直接丢弃"
      ]
    },
    {
      "dot": "rose",
      "title": "Ordinal Routing",
      "items": [
        "每个业务命令 DbNodePutReq / DbNodeGetReq / QueryIdsReq 对应唯一 P2PCommand.ordinal；跨语言 wire-format 生成器保持一致"
      ]
    },
    {
      "dot": "amber",
      "title": "maxFrameBytes",
      "items": [
        "Session 协商 maxFrameBytes；后续发送自动分块 UDP v2 Segment + QUIC/TCP stream chunking"
      ]
    }
  ]
