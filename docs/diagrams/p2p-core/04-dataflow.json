  "cards": [
    {
      "dot": "cyan",
      "title": "Single Wire Format",
      "items": [
        "4 种 SDK / 4 种传输统一 Frame Codec；maxFrameBytes、P2PCommand 路由一致，跨 SDK 透明"
      ]
    },
    {
      "dot": "rose",
      "title": "StdCancel",
      "items": [
        "取消路径和业务路径分离：StdCancel 只影响本 session RPC；其他连接会话不受影响；Python/C/TS/Dart SDK 都实现同构 stop 帧语义"
      ]
    },
    {
      "dot": "emerald",
      "title": "Transport Agnostic",
      "items": [
        "应用层看不到传输差异：UDP/QUIC/TCP/WS 进入 Server Router 前已完整还原同一个解密后的业务帧"
      ]
    }
  ]
