    },
    {
      "id": "exchange",
      "label": "Key Exchange",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "session",
      "label": "Session OK",
      "fromCol": 3,
      "toCol": 4
