  "cards": [
    {
      "dot": "cyan",
      "title": "p2p-db 三角色",
      "items": [
        "Message Store = MVCC 存 message body；Conv/User Index = 查询收件箱；Presence = DsFreeRing(64-bit uid Set) 作为「在线 uid 集合」语义"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two Delivery Path",
      "items": [
        "用户在线 Presence in set → WS 直接推；离线 → Push Service 走系统推送，并在消息索引中标记 unread"
      ]
    },
    {
      "dot": "rose",
      "title": "Receipts",
      "items": [
        "delivered/read receipt 是双向显式事件；客户端发送 receipt 给 Ingest → 更新 msg-index 对应消息状态"
      ]
    }
  ],
