  "cards": [
    {
      "dot": "emerald",
      "title": "MVCC Write Order",
      "items": [
        "先分配 versionId/rowId 写 MVCC 槽 → 更 Index → 最后 append Binlog REDO",
        "Binlog 位置 exclusive watermark: fixedOffset=下帧偏移, sequence=最后写帧序号"
      ]
    },
    {
      "dot": "rose",
      "title": "FNV tableId",
      "items": [
        "Binlog 每条表用 class.getName() 的 FNV-1a 作 tableId",
        "列 colId 用 schema 中 0-based 列序，schema 改则 signature 改变"
      ]
    },
    {
      "dot": "amber",
      "title": "New Slot All-Zero Invariant",
      "items": [
        "DsFixedBucketStore.get 对新 slot 返回全零",
        "old row 解读必须 isAllZero(bytes) 判定，否则 INSERT 会错写 UPDATE + UNDO"
      ]
    }
  ]
