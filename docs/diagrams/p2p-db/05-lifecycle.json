{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "p2p-db MVCC Entity Version Lifecycle",
    "viewBox": [
      1700,
      3000
    ],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "locale": "zh-CN"
  },
  "lanes": [
    {
      "id": "main",
      "label": "MVCC Version Rail"
    },
    {
      "id": "index",
      "label": "Index Invalidation"
    },
    {
      "id": "binlog",
      "label": "Binlog + Backup"
    },
    {
      "id": "terminal",
      "label": "Terminal States"
    }
  ],
  "states": [
    {
      "id": "inserted",
      "type": "active",
      "label": "Inserted v1",
      "sublabel": "rowId + versionId",
      "lane": "main",
      "col": 0,
      "step": "02",
      "tag": "committed",
      "yOffset": 0,
      "width": 140,
      "height": 86
    },
    {
      "id": "update-v3",
      "type": "active",
      "label": "Update v3",
      "sublabel": "readTimestamp resolve",
      "lane": "main",
      "col": 0,
      "step": "04",
      "tag": "visible",
      "yOffset": 80,
      "width": 140,
      "height": 86
    },
    {
      "id": "redo-frm",
      "type": "active",
      "label": "Append REDO Frame",
      "sublabel": "tableId FNV-1a",
      "lane": "binlog",
      "col": 0,
      "tag": "durable",
      "yOffset": 100,
      "width": 140,
      "height": 86
    },
    {
      "id": "ok-fin",
      "type": "success",
      "label": "Restore OK",
      "sublabel": "replay [a,b)",
      "lane": "terminal",
      "col": 0,
      "tag": "terminal",
      "yOffset": 0,
      "width": 140,
      "height": 86
    },
    {
      "id": "idx-version",
      "type": "waiting",
      "label": "Index Add New",
      "sublabel": "mvcc -> versionId",
      "lane": "index",
      "col": 1,
      "tag": "retain hist",
      "yOffset": 88,
      "width": 140,
      "height": 86
    },
    {
      "id": "corrupt",
      "type": "failure",
      "label": "Schema Mismatch",
      "sublabel": "signature mismatch",
      "lane": "terminal",
      "col": 1,
      "tag": "fatal",
      "yOffset": 20,
      "width": 140,
      "height": 86
    },
    {
      "id": "new",
      "type": "start",
      "label": "New Entity",
      "sublabel": "pre-insert",
      "lane": "main",
      "col": 2,
      "step": "01",
      "tag": "transient",
      "yOffset": 80,
      "width": 140,
      "height": 86
    },
    {
      "id": "remove-v4",
      "type": "failure",
      "label": "Removed Tombstone",
      "sublabel": "row tombstone",
      "lane": "main",
      "col": 2,
      "step": "05",
      "tag": "invisible",
      "yOffset": 0,
      "width": 140,
      "height": 86
    },
    {
      "id": "idx-drop",
      "type": "waiting",
      "label": "Index Drop Old",
      "sublabel": "non-mvcc delete",
      "lane": "index",
      "col": 2,
      "tag": "cleanup",
      "yOffset": 100,
      "width": 140,
      "height": 86
    },
    {
      "id": "snap-full",
      "type": "waiting",
      "label": "Full Snapshot",
      "sublabel": "Files.copy",
      "lane": "binlog",
      "col": 2,
      "tag": "stable",
      "yOffset": 100,
      "width": 140,
      "height": 86
    },
    {
      "id": "update-v2",
      "type": "active",
      "label": "Update v2",
      "sublabel": "patchNonMvccCols",
      "lane": "main",
      "col": 3,
      "step": "03",
      "tag": "visible",
      "yOffset": 80,
      "width": 140,
      "height": 86
    }
  ],
  "transitions": [
    {
      "from": "inserted",
      "to": "idx-drop",
      "variant": "security",
      "channelX": 800,
      "channelY": 1560,
      "toSide": "left"
    },
    {
      "from": "update-v2",
      "to": "redo-frm",
      "variant": "dashed",
      "channelY": -400
    },
    {
      "from": "update-v3",
      "to": "idx-version",
      "variant": "default",
      "channelY": 630
    },
    {
      "from": "remove-v4",
      "to": "snap-full",
      "variant": "dashed",
      "channelX": -400,
      "channelY": -2070,
      "fromSide": "right"
    },
    {
      "from": "redo-frm",
      "to": "ok-fin",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "new",
      "to": "corrupt",
      "variant": "security",
      "channelY": -400
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Version Visibility",
      "items": [
        "读取 readTimestamp 解析可见版本；非 MVCC 列 patchNonMvccCols 从最新提交写入覆盖",
        "@DsTable(mvcc=true) 等价所有列 mvcc=true"
      ]
    },
    {
      "dot": "rose",
      "title": "Signature Safety",
      "items": [
        "SchemaDef.signature 的 |M= 列级位标记；开关 mvcc 改 schemaId；老版本读会 signature mismatch 终止而非脏读"
      ]
    },
    {
      "dot": "emerald",
      "title": "Restore Replay",
      "items": [
        "replayBinlog 期间 DsBinlogContext.isInReplay() 短路 append，不产生新 Binlog",
        "并行重放：按 rowKey 分片；实际 put/remove 串行锁"
      ]
    }
  ]
}
